[Unit]
Description=Calendarly Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xxtoon
WorkingDirectory=/opt/calendarly/server
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/opt/calendarly/data
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
